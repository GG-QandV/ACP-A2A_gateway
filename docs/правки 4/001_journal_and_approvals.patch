@@ -0,0 +1,50 @@
+use chrono::Utc;
+use serde::Serialize;
+use std::fs::OpenOptions;
+use std::io::Write;
+
+#[derive(Serialize)]
+struct JournalEntry {
+    timestamp: String,
+    event: String,
+    agent: String,
+    status: String,
+    approval: String,
+}
+
+pub fn log_to_journal(agent: &str, status: &str, approval: &str) -> anyhow::Result<()> {
+    let entry = JournalEntry {
+        timestamp: Utc::now().to_rfc3339(),
+        event: "agent_connected".to_string(),
+        agent: agent.to_string(),
+        status: status.to_string(),
+        approval: approval.to_string(),
+    };
+
+    let line = serde_json::to_string(&entry)?;
+    let mut file = OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open("journal.jsonl")?;
+    
+    writeln!(file, "{}", line)?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_log_to_journal() {
+        log_to_journal("claurst-main", "allowed", "permanent").unwrap();
+        // Проверить, что journal.jsonl содержит запись
+    }
+}
