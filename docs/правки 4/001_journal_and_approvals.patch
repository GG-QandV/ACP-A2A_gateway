@@ -0,0 +1,50 @@
+use serde::{Deserialize, Serialize};
+use std::fs;
+
+#[derive(Serialize, Deserialize, Clone)]
+pub struct ApprovedAgents {
+    pub agents: Vec<ApprovedAgent>,
+}
+
+#[derive(Serialize, Deserialize, Clone)]
+pub struct ApprovedAgent {
+    pub name: String,
+    pub approved_at: String,
+    pub permanent: bool,
+}
+
+pub fn load_approved_agents(path: &str) -> anyhow::Result<ApprovedAgents> {
+    if !std::path::Path::new(path).exists() {
+        return Ok(ApprovedAgents { agents: Vec::new() });
+    }
+
+    let json = fs::read_to_string(path)?;
+    let approved: ApprovedAgents = serde_json::from_str(&json)?;
+    Ok(approved)
+}
+
+pub fn save_approved_agents(path: &str, approved: &ApprovedAgents) -> anyhow::Result<()> {
+    let json = serde_json::to_string_pretty(approved)?;
+    fs::write(path, json)?;
+    Ok(())
+}
+
+pub fn is_approved(approved: &ApprovedAgents, agent_name: &str) -> bool {
+    approved.agents.iter().any(|a| a.name == agent_name)
+}
+
+pub fn revoke_approval(path: &str, agent_name: &str) -> anyhow::Result<()> {
+    let mut approved = load_approved_agents(path)?;
+    approved.agents.retain(|a| a.name != agent_name);
+    save_approved_agents(path, &approved)?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_load_save_approved_agents() {
+        // Тест загрузки/сохранения
+    }
+}
